<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/drag_handle"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:paddingTop="16dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/timer_time_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:paddingHorizontal="10dp"
                android:gravity="center"
                android:fontFeatureSettings="tnum"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textDirection="locale"
                android:focusable="true"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="01:23" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/timer_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:drawableStart="@drawable/ic_label"
                android:drawablePadding="10dp"
                android:drawableTint="?attr/colorOnSurfaceVariant"
                android:gravity="center_vertical"
                android:focusable="true"
                android:text="@string/add_label"
                app:layout_constraintTop_toBottomOf="@id/timer_time_text" />

            <LinearLayout
                android:id="@+id/add_time_button_layout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@id/timer_label">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/add_time_button_title"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingHorizontal="10dp"
                    android:drawableStart="@drawable/ic_more_time"
                    android:drawablePadding="10dp"
                    android:drawableTint="?attr/colorOnSurfaceVariant"
                    android:gravity="center_vertical"
                    android:focusable="true"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/add_time_button_title" />

                <com.google.android.material.button.MaterialButton
                    style="?attr/materialButtonOutlinedStyle"
                    android:id="@+id/add_time_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_gravity="center"
                    android:textColor="?android:attr/textColorPrimary"
                    android:includeFontPadding="false"
                    app:strokeColor="?attr/colorOnSurfaceVariant"
                    tools:text="+1:00"
                    tools:visibility="visible" />

            </LinearLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/delete_timer_after_use"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="10dp"
                android:button="@null"
                android:drawableStart="@drawable/ic_clear"
                android:drawableEnd="@drawable/ic_selector_checkbox"
                android:drawablePadding="10dp"
                android:text="@string/delete_timer_after_use_title"
                app:layout_constraintTop_toBottomOf="@id/add_time_button_layout"
                tools:ignore="RtlSymmetry"
                tools:checked="true" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:backgroundTint="@color/colorAlert"
            android:text="@string/delete"
            android:textColor="?attr/colorOnError"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            app:icon="@drawable/ic_delete"
            app:iconTint="?attr/colorOnError"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/duplicate_button"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0"
            tools:ignore="TextContrastCheck" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/duplicate_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:backgroundTint="?attr/colorPrimary"
            android:text="@string/duplicate"
            android:textColor="?attr/colorSurfaceContainerLowest"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            app:icon="@drawable/ic_duplicate"
            app:iconTint="?attr/colorSurfaceContainerLowest"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/delete_button"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constrainedWidth="true"
            tools:textStyle="bold" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
