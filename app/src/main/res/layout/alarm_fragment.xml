<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/alarm_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/volume_warning_banner"
        android:id="@+id/alarm_volume_warning_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/alarm_category_tabs_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="200dp"
        android:clickable="false"
        android:focusable="false"
        android:checkable="false"
        app:cardBackgroundColor="@android:color/transparent"
        app:strokeColor="?attr/colorOutline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/add_category_button"
        app:layout_constraintTop_toBottomOf="@+id/alarm_volume_warning_banner"
        app:layout_goneMarginTop="0dp">

        <com.google.android.material.tabs.TabLayout
            style="@style/CustomTabLayoutStyle"
            android:id="@+id/alarm_category_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="SpeakableTextPresentCheck" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        style="?attr/materialIconButtonOutlinedStyle"
        android:id="@+id/add_category_button"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="10dp"
        android:insetLeft="0dp"
        android:insetBottom="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:contentDescription="@string/add_category_description"
        app:icon="@drawable/ic_create_new_folder"
        app:iconGravity="textStart"
        app:strokeColor="?attr/colorOutline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/alarm_category_tabs_container"
        app:layout_constraintBottom_toBottomOf="@+id/alarm_category_tabs_container" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/alarm_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="10dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/alarm_category_tabs_container"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/alarm_item" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/alarm_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingBottom="@dimen/alarm_empty_view_bottom_padding"
        app:layout_constraintTop_toBottomOf="@+id/alarm_category_tabs_container"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone"
        android:alpha="0.7">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/blob"
            android:contentDescription="@string/no_alarms"
            app:layout_constraintWidth_max="@dimen/max_dimension_empty_view"
            app:layout_constraintHeight_max="@dimen/max_dimension_empty_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_empty_alarm_view"
            android:scaleX="0.6"
            android:scaleY="0.6"
            android:alpha="0.5"
            android:contentDescription="@string/no_alarms"
            app:layout_constraintWidth_max="@dimen/max_dimension_empty_view"
            app:layout_constraintHeight_max="@dimen/max_dimension_empty_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
