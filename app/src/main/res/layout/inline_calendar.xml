<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/month_year_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/month_year_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/prev_year"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/prev_year"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_double_left"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/prev_month"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/prev_month"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_left"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/next_month"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_month"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_right"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/next_year"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_year"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_double_right"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/calendar_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <LinearLayout
        android:id="@+id/calendar_summary_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/calendar_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/cleanup_overrides"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/cleanup_overrides"
            android:src="@drawable/ic_refresh"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/home_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/jump_to_current_month"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_home"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/date_action_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/date_action_description"
            android:visibility="gone"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_calendar"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
