<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="?attr/dialogPreferredPadding">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/alarm_blur_intensity_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:gravity="center"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="20" />

        <ImageView
            android:id="@+id/slider_minus_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_blur_decrease"
            android:contentDescription="@null"
            android:scaleType="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/alarm_blur_intensity_slider"
            app:layout_constraintBottom_toBottomOf="@+id/alarm_blur_intensity_slider" />

        <com.google.android.material.slider.Slider
            android:id="@+id/alarm_blur_intensity_slider"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            app:labelBehavior="gone"
            app:layout_constraintStart_toEndOf="@+id/slider_minus_icon"
            app:layout_constraintEnd_toStartOf="@+id/slider_plus_icon"
            app:layout_constraintTop_toBottomOf="@+id/alarm_blur_intensity_value"
            tools:progress="70" />

        <ImageView
            android:id="@+id/slider_plus_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_blur_increase"
            android:contentDescription="@null"
            android:scaleType="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/alarm_blur_intensity_slider"
            app:layout_constraintBottom_toBottomOf="@+id/alarm_blur_intensity_slider" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
