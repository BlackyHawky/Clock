<com.best.deskclock.timer.TimerItemCompact xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:background="@drawable/bg_card_for_preview"
    tools:layout_marginBottom="2dp"
    tools:layout_marginHorizontal="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/timer_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/timer_label"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/timer_indicator_state"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="TextContrastCheck"
            tools:text="2m Timer" />

        <View
            android:id="@+id/timer_indicator_state"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:background="@drawable/bg_circle_for_preview"
            tools:backgroundTint="#FF99CC00" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/timer_controls_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timer_top"
        app:layout_constraintBottom_toTopOf="@+id/timer_end_time"
        app:layout_goneMarginTop="20dp">

        <com.best.deskclock.uicomponents.AutoSizingTextView
            android:id="@+id/timer_time_text"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:textSize="40sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/reset_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            tools:text="01:23" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset_button"
            style="?attr/materialIconButtonFilledStyle"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/reset"
            app:icon="@drawable/ic_reset"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?android:attr/colorBackground"
            app:layout_constraintEnd_toStartOf="@+id/timer_add_time_button"
            app:layout_constraintTop_toTopOf="@+id/play_pause_button"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause_button"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small"
            tools:ignore="TouchTargetSizeCheck" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/timer_add_time_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textDirection="locale"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@+id/play_pause_button"
            app:layout_constraintTop_toTopOf="@+id/play_pause_button"
            app:layout_constraintBottom_toBottomOf="@+id/play_pause_button"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Small"
            app:strokeColor="?attr/colorOnSurfaceVariant"
            tools:text="+ 1:00"
            tools:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/play_pause_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/timer_start"
            android:scaleType="centerInside"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?android:attr/colorBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Small"
            tools:icon="@drawable/ic_fab_play" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/timer_end_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textStyle="italic"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timer_controls_container"
        app:layout_constraintVertical_bias="0"
        tools:ignore="TextContrastCheck"
        tools:text="End time: 8:30 PM"
        tools:visibility="visible" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/linear_progress_indicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:max="1000"
        app:indicatorColor="?attr/colorSecondary"
        app:indicatorDirectionLinear="endToStart"
        app:layout_constraintTop_toBottomOf="@+id/timer_end_time"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_goneMarginTop="16dp"
        app:trackColor="?attr/colorPrimaryInverse"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:progress="650" />

</com.best.deskclock.timer.TimerItemCompact>
